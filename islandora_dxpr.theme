<?php

/**
 * @file
 * DXPR Theme sub-theme.
 */

use Drupal\Component\Utility\Html;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element;
use Drupal\Core\StringTranslation\TranslatableMarkup;
use Drupal\Core\Url;

/**
 * Implements hook_preprocess_block().
 */
function islandora_dxpr_preprocess_block(array &$variables): void {
  $plugin_id = $variables['plugin_id'] ?? '';
  if ($plugin_id === '') {
    return;
  }

  // Give JavaScript and institutional subthemes a stable class that represents
  // the complete plugin ID, including derivative IDs.
  $variables['attributes']['class'][] = 'block-plugin-id--' . Html::getClass($plugin_id);

  // Render the compact repository search with a real button so its icon can
  // remain crisp in forced-colors mode while its translated label stays in
  // the accessibility tree. The wrapper is changed here because the Advanced
  // Search block builds the Form API element before the theme sees it.
  if (
    $plugin_id === 'search_block' &&
    isset($variables['content']['actions']['submit'])
  ) {
    $form = &$variables['content'];
    $form['#attributes']['class'][] = 'islandora-header-search';
    if (isset($form['search-textfield'])) {
      $form['search-textfield']['#attributes']['class'][] =
        'islandora-header-search__input';
      $placeholder =
        $form['search-textfield']['#attributes']['placeholder'] ?? '';
      if (trim((string) $placeholder) === '') {
        $form['search-textfield']['#attributes']['placeholder'] =
          new TranslatableMarkup('Search the repository');
      }
    }
    $form['actions']['#attributes']['class'][] =
      'islandora-header-search__actions';
    $form['actions']['submit']['#attributes']['class'][] =
      'islandora-header-search__submit';
    $search_label = new TranslatableMarkup('Search the repository');
    $form['actions']['submit']['#attributes']['aria-label'] = $search_label;
    $form['actions']['submit']['#attributes']['data-bs-placement'] = 'bottom';
    $form['actions']['submit']['#attributes']['data-bs-title'] = $search_label;
    $form['actions']['submit']['#attributes']['data-bs-toggle'] = 'tooltip';
    $form['actions']['submit']['#attributes']['data-islandora-tooltip'] = 'true';
    unset($form['actions']['submit']['#attributes']['title']);
    $variables['content']['actions']['submit']['#theme_wrappers'] = [
      'input__submit__islandora_search',
    ];
    unset($form);
  }

  // Advanced Search currently discovers pager blocks by the class emitted by
  // the Starter Site's former Olivero templates. Keep that public integration
  // point while using DXPR's block template so AJAX paging continues to work.
  if (str_starts_with($plugin_id, 'advanced_search_result_pager:')) {
    $variables['attributes']['class'][] = 'block-plugin-id--islandora-advanced-search-result-pager';
    if (isset($variables['content']['container']['sort_by'])) {
      $sort = &$variables['content']['container']['sort_by'];
      unset(
        $sort['#options']['search_api_relevance_asc'],
        $sort['#options_attributes']['search_api_relevance_asc'],
      );
      if (isset($sort['#options']['search_api_relevance_desc'])) {
        $sort['#options']['search_api_relevance_desc'] =
          new TranslatableMarkup('Relevance');
      }
      unset($sort);
    }
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for the Advanced Search form.
 */
function islandora_dxpr_form_advanced_search_form_alter(
  array &$form,
  FormStateInterface $form_state,
  string $form_id,
): void {
  if (!isset($form['ajax']['terms'])) {
    return;
  }

  $term_keys = Element::children($form['ajax']['terms']);
  foreach ($term_keys as $position => $term_key) {
    $term = &$form['ajax']['terms'][$term_key];
    $term['#type'] = 'container';
    $term['#attributes']['class'][] =
      'islandora-advanced-search__condition';
    $term['#attributes']['role'] = 'group';
    $term['#attributes']['aria-label'] = new TranslatableMarkup(
      'Search condition @number',
      ['@number' => $position + 1],
    );
    if (!isset($term['conjunction'])) {
      $term['#attributes']['class'][] =
        'islandora-advanced-search__condition--first';
    }
    else {
      $term['#attributes']['class'][] =
        'islandora-advanced-search__condition--additional';
    }

    $control_classes = [
      'conjunction' => 'conjunction',
      'search' => 'field',
      'include' => 'operator',
      'value' => 'value',
    ];
    foreach ($control_classes as $control_key => $class_suffix) {
      if (isset($term[$control_key])) {
        $term[$control_key]['#attributes']['class'][] =
          'islandora-advanced-search__' . $class_suffix;
      }
    }

    $actions = &$term['actions'];
    $actions['#attributes']['class'][] =
      'islandora-advanced-search__condition-actions';
    $action_labels = [
      'add' => new TranslatableMarkup('Add another search condition'),
      'remove' => new TranslatableMarkup('Remove this search condition'),
    ];
    foreach ($action_labels as $action_key => $label) {
      if (!isset($actions[$action_key])) {
        continue;
      }

      $actions[$action_key]['#attributes']['aria-label'] = $label;
      $actions[$action_key]['#attributes']['data-bs-placement'] = 'top';
      $actions[$action_key]['#attributes']['data-bs-title'] = $label;
      $actions[$action_key]['#attributes']['data-bs-toggle'] = 'tooltip';
      $actions[$action_key]['#attributes']['data-islandora-tooltip'] = 'true';
      unset($actions[$action_key]['#attributes']['title']);
    }
    if (isset($actions['remove'])) {
      $actions['remove']['#weight'] = 0;
    }
    if (isset($actions['add'])) {
      // Keep the additive action at the far edge in visual and tab order.
      $actions['add']['#weight'] = 10;
    }
    unset($actions);
    unset($term);
  }

  $form['#attributes']['class'][] = 'islandora-advanced-search';
  $form['ajax']['#attributes']['class'][] =
    'islandora-advanced-search__builder';
  $form['ajax']['terms']['#attributes']['class'][] =
    'islandora-advanced-search__conditions';

  // This form shares Drupal's default edit-submit ID with the compact header
  // search when both blocks are present on collection and search pages.
  if (isset($form['submit'])) {
    $form['submit']['#attributes']['id'] = 'edit-submit-advanced-search';
    $form['submit']['#attributes']['class'][] =
      'islandora-advanced-search__submit';
  }
  if (isset($form['reset'])) {
    $form['reset']['#attributes']['id'] = 'edit-reset-advanced-search';
    $form['reset']['#attributes']['class'][] =
      'islandora-advanced-search__reset';
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for fieldset.
 */
function islandora_dxpr_theme_suggestions_fieldset_alter(
  array &$suggestions,
  array $variables,
): void {
  $selector =
    $variables['element']['#attributes']['data-drupal-selector'] ?? '';
  if ($selector === 'edit-resource-type') {
    $suggestions[] = 'fieldset__islandora_facet_resource_type';
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for Views exposed forms.
 */
function islandora_dxpr_form_views_exposed_form_alter(
  array &$form,
  FormStateInterface $form_state,
  string $form_id,
): void {
  $view = $form_state->get('view');
  if (!is_object($view) || $view->id() !== 'solr_search_content') {
    return;
  }

  $display_id = $view->current_display;
  if (!in_array($display_id, ['page_1', 'block_1'], TRUE)) {
    return;
  }

  // Advanced Search provides the result toolbar for these displays. Keep one
  // sorting and page-size control set instead of repeating it in the filters.
  unset($form['sort_by'], $form['sort_order'], $form['items_per_page']);

  if ($display_id === 'block_1') {
    // The inherited View action points at /search and drops the collection's
    // contextual argument. Views also restores path.current during its AJAX
    // callback, so this remains the collection path after every rebuild.
    $current_path = \Drupal::service('path.current')->getPath();
    $form['#action'] = Url::fromUserInput($current_path)->toString();
    $form['#cache']['contexts'][] = 'url.path';
  }

  $suffix = Html::getClass($view->id() . '-' . $display_id);
  if (isset($form['actions'])) {
    $form['actions']['#attributes']['id'] = 'edit-actions-' . $suffix;
    foreach (Element::children($form['actions']) as $action_key) {
      $form['actions'][$action_key]['#attributes']['id'] =
        'edit-' . Html::getClass($action_key) . '-' . $suffix;
    }
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for the citation selector.
 */
function islandora_dxpr_form_citation_select_select_citation_alter(
  array &$form,
  FormStateInterface $form_state,
  string $form_id,
): void {
  // The citation block can appear beside the compact header search. Both use
  // Drupal's generic actions/submit keys, so give the citation controls unique
  // document IDs while leaving their form API selectors intact.
  if (isset($form['container-citation']['actions'])) {
    $actions = &$form['container-citation']['actions'];
    $actions['#attributes']['id'] = 'edit-actions-citation-select';
    if (isset($actions['submit'])) {
      $actions['submit']['#attributes']['id'] = 'edit-submit-citation-select';
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for menu.
 */
function islandora_dxpr_preprocess_menu(array &$variables): void {
  if (!isset($variables['items']) || !is_array($variables['items'])) {
    return;
  }

  $route_match = \Drupal::routeMatch();
  $current_route = (string) $route_match->getRouteName();
  $current_parameters = $route_match->getRawParameters()->all();
  $current_path = \Drupal::service('path.current')->getPath();
  islandora_dxpr_mark_current_menu_items(
    $variables['items'],
    $current_route,
    $current_parameters,
    $current_path,
  );
}

/**
 * Marks the current menu item and its ancestors for accessible presentation.
 */
function islandora_dxpr_mark_current_menu_items(
  array &$items,
  string $current_route,
  array $current_parameters,
  string $current_path,
): bool {
  $contains_active_item = FALSE;

  foreach ($items as &$item) {
    $is_current = FALSE;
    $url = $item['url'] ?? NULL;

    if ($url instanceof Url && $url->isRouted()) {
      $is_current = $url->getRouteName() === $current_route;
      foreach ($url->getRouteParameters() as $key => $value) {
        $is_current = $is_current &&
          isset($current_parameters[$key]) &&
          (string) $current_parameters[$key] === (string) $value;
      }

      if (!$is_current) {
        $item_path = parse_url($url->toString(), PHP_URL_PATH) ?: '/';
        $is_current = rtrim($item_path, '/') === rtrim($current_path, '/');
      }
    }

    $child_is_active = FALSE;
    if (!empty($item['below']) && is_array($item['below'])) {
      $child_is_active = islandora_dxpr_mark_current_menu_items(
        $item['below'],
        $current_route,
        $current_parameters,
        $current_path,
      );
    }

    $item['is_current'] = $is_current;
    if ($is_current || $child_is_active) {
      $item['in_active_trail'] = TRUE;
    }
    $contains_active_item = $contains_active_item ||
      !empty($item['in_active_trail']);
  }
  unset($item);

  return $contains_active_item;
}

/**
 * Implements hook_preprocess_HOOK() for views_view.
 */
function islandora_dxpr_preprocess_views_view(array &$variables): void {
  $view = $variables['view'] ?? NULL;
  if (!is_object($view) || $view->id() !== 'top_level_collections') {
    return;
  }

  if (($view->current_display ?? '') !== 'page_1') {
    return;
  }

  // Generate this prominent discovery link through Drupal so language prefixes
  // and installations below a web-root continue to resolve the search route.
  $variables['header']['islandora_search_cta'] = [
    '#type' => 'link',
    '#title' => new TranslatableMarkup('Search all repository content'),
    '#url' => Url::fromRoute('view.solr_search_content.page_1'),
    '#attributes' => [
      'class' => ['islandora-collections-search-cta'],
    ],
    '#prefix' => '<p class="islandora-collections-search-action">',
    '#suffix' => '</p>',
  ];
}

/**
 * Implements hook_preprocess_HOOK() for image_style.
 */
function islandora_dxpr_preprocess_image_style(array &$variables): void {
  if (($variables['style_name'] ?? '') !== 'islandora_card') {
    return;
  }

  if (!isset($variables['image']) || !is_array($variables['image'])) {
    return;
  }

  $image = &$variables['image'];
  $alt = trim((string) ($image['#alt'] ?? $image['#attributes']['alt'] ?? ''));
  $uri = (string) ($image['#uri'] ?? '');
  $path = parse_url($uri, PHP_URL_PATH) ?: $uri;
  $filename = rawurldecode(basename($path));
  $normalized_alt = preg_replace('/[^\p{L}\p{N}]+/u', '', $alt) ?? '';
  $normalized_filename = preg_replace('/[^\p{L}\p{N}]+/u', '', $filename) ?? '';

  // Starter content can inherit a source filename as its alternative. That
  // adds noise beside the linked record title, while genuinely authored alt
  // text can convey useful thumbnail information and must be preserved. The
  // normalized comparison accommodates Drupal's filename sanitization.
  if (
    $alt !== '' &&
    $filename !== '' &&
    (
      strcasecmp($alt, $filename) === 0 ||
      ($normalized_alt !== '' &&
        strcasecmp($normalized_alt, $normalized_filename) === 0)
    )
  ) {
    $image['#alt'] = '';
    $image['#attributes']['alt'] = '';
  }
}

/**
 * Implements hook_preprocess_HOOK() for facets_result_item.
 */
function islandora_dxpr_preprocess_facets_result_item(array &$variables): void {
  if (!is_array($variables['value'] ?? NULL)) {
    return;
  }

  $value = $variables['value']['text']['#title']
    ?? $variables['raw_value']
    ?? new TranslatableMarkup('filter');
  $labels = [
    'include' => new TranslatableMarkup('Include @value', ['@value' => $value]),
    'exclude' => new TranslatableMarkup('Exclude @value', ['@value' => $value]),
  ];

  foreach ($labels as $key => $label) {
    if (isset($variables['value'][$key])) {
      $variables['value'][$key]['#attributes']['aria-label'] = $label;
      $variables['value'][$key]['#attributes']['title'] = $label;
    }
  }
}
