{#
/**
 * @file
 * Adds a real card surface inside each Views Bootstrap grid column.
 */
#}
{% set classes = ['views-view-grid', 'row'] %}
{% if title %}
  <h3>{{ title }}</h3>
{% endif %}
<div id="{{ id }}" {{ attributes.addClass(classes) }}>
  {% for row in rows %}
    <div{{ row.attributes }}>
      <article class="islandora-collection-card h-100">
        {{- row.content -}}
      </article>
    </div>
  {% endfor %}
</div>
